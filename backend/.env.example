# ==============================================================================
# AARA — Personal AI Voice & Chat Assistant
# Environment Variables Configuration Template
# ==============================================================================

# Server Port
PORT=5000

# Allowed Frontend Client Origin
CLIENT_ORIGIN=http://localhost:5173

# AI Provider Configuration
# Options: 'groq' | 'gemini' | 'openai' | 'demo'
AI_PROVIDER=groq

# Groq API Configuration (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Connection String (Atlas Cloud or Localhost)
MONGODB_URI=your_mongodb_connection_string_here