# ==============================================================================
# AARA — Personal AI Voice & Chat Assistant
# Configuration Environment Variables
# External service budget: ₹0 (Zero mandatory cost)
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Allowed Frontend Client Origin
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Optional)
# If left blank or if MongoDB is not running locally, Aara automatically falls back
# to zero-cost local JSON persistence without any errors or crashes.
# Free Atlas cluster URI or local MongoDB: mongodb://localhost:27017/aara_assistant
MONGODB_URI=mongodb://localhost:27017/aara_assistant

# AI Provider Configuration
# Options:
#   'local'  -> 100% Free Zero-Cost Built-in Local Knowledge Engine (No API key needed!)
#   'gemini' -> Google Gemini Free Tier (requires free Google AI Studio key)
#   'groq'   -> Groq Fast Free Tier (requires free GroqCloud key)
#   'openai' -> OpenAI or local Ollama endpoint (e.g. http://localhost:11434/v1)
AI_PROVIDER=local

# AI API Key (Optional)
# Leave blank for ₹0 Local Mode. Never commit actual secret keys to Git.
AI_API_KEY=

# Custom AI Base URL (Optional, for Ollama or local LLMs)
# Example for local Ollama: http://localhost:11434/v1
AI_BASE_URL=

# AI Model Name (Optional)
# Examples:
#   gemini-1.5-flash (for Gemini)
#   llama-3.3-70b-versatile (for Groq)
#   llama3 (for Ollama)
AI_MODEL=
