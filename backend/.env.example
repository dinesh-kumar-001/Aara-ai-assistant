# ==============================================================================
# AARA — Personal AI Voice & Chat Assistant
# Environment Variables Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Allowed Frontend Client Origin
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Optional)
# If left blank or if MongoDB is unreachable, Aara automatically falls back
# to zero-cost local JSON storage without any interruption.
MONGODB_URI=mongodb://localhost:27017/aara_assistant

# AI Provider Configuration
# Recommended: 'gemini' (Free tier via Google AI Studio)
# Options:
#   'gemini' -> Genuine Google Gemini API (Recommended, fast & free tier available)
#   'groq'   -> Groq API (llama-3.3-70b-versatile)
#   'openai' -> OpenAI or local Ollama endpoint
#   'demo'   -> Offline Local Demo Mode (No API key needed; explicitly labeled demo responses)
AI_PROVIDER=gemini

# AI API Key (REQUIRED for Live Real AI)
# Get a 100% free Gemini API key with zero credit card from:
# https://aistudio.google.com -> Click "Get API key"
AI_API_KEY=your_gemini_api_key_here

# Custom AI Base URL (Optional, e.g., for Ollama: http://localhost:11434/v1)
AI_BASE_URL=

# AI Model Name (Optional)
# Recommended for Gemini: 'gemini-1.5-flash' or 'gemini-2.0-flash'
AI_MODEL=gemini-1.5-flash
